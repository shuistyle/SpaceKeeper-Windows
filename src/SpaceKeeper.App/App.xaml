<!--
  App.xaml — app-wide resources.
  • XamlControlsResources loads the standard Windows 11 (Fluent) look for every control,
    including dark mode and high-contrast themes.
  • IconButtonStyle is our small borderless button for icons (pin, switch, remove).
    Its 32 × 32 minimum size keeps it easy to click and tap.
-->
<Application
    x:Class="SpaceKeeper.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
