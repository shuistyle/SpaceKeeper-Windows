<?xml version="1.0" encoding="utf-8"?>
<!--
  PanelWindow.xaml — the SpaceKeeper panel (opens from the tray icon,
  by double-tapping Ctrl, or with Ctrl+Alt+S).

  How to read this file:
  • Each <Element> is something on screen; nesting = "inside".
  • {x:Bind ViewModel.Something} links an element to a property in
    MainViewModel. Mode=OneWay keeps it updated; Mode=TwoWay also writes
    changes back (e.g. a toggle switch changing a setting).
  • Inside the tile template, {x:Bind Something} refers to that tile's
    DesktopTileViewModel instead.
  • Command="{x:Bind ...Command}" runs a method marked [RelayCommand].
  • AutomationProperties.* is what screen readers (Narrator, NVDA, JAWS)
    say, and HeadingLevel lets their users jump between sections.

  Layout, top to bottom (same design as the Mac version):
  header → pinned-order warning → DESKTOP GRID (up to 8 tiles per row) →
  Settings (collapsed until you open it) → status line → diagnostics → footer.

  The window's width and height are set in PanelWindow.xaml.cs to fit
  the grid, so there's normally no scroll bar.
-->
<Window
    x:Class="SpaceKeeper.App.Views.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SpaceKeeper.App.ViewModels"
    xmlns:views="using:SpaceKeeper.App.Views"
    Title="SpaceKeeper">

    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <!-- Esc closes the panel (or cancels renaming); Ctrl+N adds a desktop.
                 Ctrl+Plus / Ctrl+Minus / Ctrl+0 (tile size) are added in PanelWindow.xaml.cs. -->
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnAddDesktopShortcut" />
        </Grid.KeyboardAccelerators>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- PanelContent's height is measured to size the window (see FitHeight). -->
            <StackPanel x:Name="PanelContent" Padding="16" Spacing="12">

                <!-- ===== HEADER: current desktop ===== -->
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Current desktop"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentName, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentSubtitle, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Top"
                            Style="{StaticResource IconButtonStyle}"
                            Click="OnOpenTaskView"
                            AutomationProperties.Name="Open Task View"
                            ToolTipService.ToolTip="Open Task View (Win+Tab)">
                        <FontIcon Glyph="&#xE7C4;" FontSize="18" />
                    </Button>
                </Grid>

                <!-- ===== WARNING: pinned order changed (InfoBar is announced by screen readers) ===== -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasPinAlerts, Mode=OneWay}"
                         Severity="Warning"
                         IsClosable="False"
                         Title="Pinned order changed"
                         Message="{x:Bind ViewModel.PinAlertsText, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="Accept new order" Command="{x:Bind ViewModel.AcceptNewOrderCommand}" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                            <HyperlinkButton Content="Open Task View to drag it back" Click="OnOpenTaskView" />
                            <HyperlinkButton Content="Unpin closed desktops" Command="{x:Bind ViewModel.UnpinMissingCommand}" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <!-- ===== INSTALL prompt (security: see Services/InstallService.cs) ===== -->
                <InfoBar IsOpen="{x:Bind ViewModel.ShowInstallPrompt, Mode=OneWay}"
                         Severity="Informational"
                         IsClosable="True"
                         Title="Install SpaceKeeper"
                         Message="{x:Bind ViewModel.InstallPromptText, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="Install" Command="{x:Bind ViewModel.InstallCommand}"
                                AutomationProperties.Name="Install SpaceKeeper to your apps folder"
                                ToolTipService.ToolTip="Copies SpaceKeeper to AppData\Local\Programs\SpaceKeeper and restarts it from there." />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- ===== DESKTOPS heading, count and Add button ===== -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Desktops"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DesktopCountText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <HyperlinkButton Grid.Column="2" Content="Reset to Task View order"
                                     Visibility="{x:Bind ViewModel.HasCustomOrder, Mode=OneWay}"
                                     Command="{x:Bind ViewModel.ResetOrderCommand}"
                                     ToolTipService.ToolTip="Your grid order is SpaceKeeper's own; Task View isn't changed." />
                    <!-- Add desktop: never greyed out for a limit, because Windows has no
                         maximum number of desktops (macOS stops at 16). It's only disabled
                         for a moment while a desktop is being added or removed. -->
                    <Button Grid.Column="3"
                            Command="{x:Bind ViewModel.AddDesktopCommand}"
                            IsEnabled="{x:Bind views:Ui.Not(ViewModel.IsChangingDesktops), Mode=OneWay}"
                            AutomationProperties.Name="Add desktop"
                            ToolTipService.ToolTip="Add a desktop (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add desktop" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Text="Click to switch · double-click or F2 to rename · drag, right-click or Alt+Shift+arrows to reorder · right-click › Colour"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <!-- ===== DESKTOP GRID =====
                     Tiles fill a row left to right, then wrap. PanelWindow.xaml.cs sets
                     how many fit in a row (8, or 4 / 2 with very large tiles) and turns
                     off the grid's own scrolling so the window grows to fit instead. -->
                <GridView x:Name="DesktopGrid"
                          ItemsSource="{x:Bind ViewModel.Tiles}"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          CanDragItems="True"
                          CanReorderItems="True"
                          AllowDrop="True"
                          DragItemsCompleted="OnDragItemsCompleted"
                          PreviewKeyDown="OnGridPreviewKeyDown"
                          Loaded="OnGridLoaded"
                          HorizontalAlignment="Center"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Desktops">
                    <GridView.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Menu,Shift" Key="Left" Invoked="OnMoveEarlier" />
                        <KeyboardAccelerator Modifiers="Menu,Shift" Key="Up" Invoked="OnMoveEarlier" />
                        <KeyboardAccelerator Modifiers="Menu,Shift" Key="Right" Invoked="OnMoveLater" />
                        <KeyboardAccelerator Modifiers="Menu,Shift" Key="Down" Invoked="OnMoveLater" />
                    </GridView.KeyboardAccelerators>

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <!-- A 4-pixel margin round each tile = an 8-pixel gap between tiles. -->
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DesktopTileViewModel">
                            <!-- One tile. The current desktop has a thick accent border AND says
                                 "current" in words (never colour alone). -->
                            <Grid Width="{x:Bind TileWidth, Mode=OneWay}"
                                  Height="{x:Bind TileHeight, Mode=OneWay}"
                                  Padding="6" RowSpacing="2" CornerRadius="8"
                                  Background="{x:Bind views:Ui.TileFill(ColorId), Mode=OneWay}"
                                  BorderBrush="{x:Bind views:Ui.TileBorder(IsCurrent), Mode=OneWay}"
                                  BorderThickness="{x:Bind views:Ui.TileBorderThickness(IsCurrent), Mode=OneWay}"
                                  Tapped="OnTileTapped"
                                  DoubleTapped="OnTileDoubleTapped"
                                  ToolTipService.ToolTip="{x:Bind TileHelp, Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Right-click menu: every action is also available here (keyboard: Shift+F10). -->
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="{x:Bind SwitchLabel, Mode=OneWay}" Command="{x:Bind SwitchCommand}" IsEnabled="{x:Bind CanSwitch, Mode=OneWay}" />
                                        <MenuFlyoutItem Text="Rename…" Command="{x:Bind RenameCommand}" />
                                        <MenuFlyoutItem Text="{x:Bind PinLabel, Mode=OneWay}" Command="{x:Bind TogglePinCommand}" />
                                        <!-- Colour: each with its symbol and name (SpaceKeeper.Core/DesktopColors.cs). -->
                                        <MenuFlyoutSubItem Text="Colour">
                                            <ToggleMenuFlyoutItem Text="None" Command="{x:Bind SetColorCommand}" CommandParameter=""
                                                                  IsChecked="{x:Bind views:Ui.HasNoColor(ColorId), Mode=OneWay}" />
                                            <ToggleMenuFlyoutItem Text="Yellow" Command="{x:Bind SetColorCommand}" CommandParameter="yellow"
                                                                  IsChecked="{x:Bind views:Ui.IsColor(ColorId, 'yellow'), Mode=OneWay}">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="●" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                            <ToggleMenuFlyoutItem Text="Orange" Command="{x:Bind SetColorCommand}" CommandParameter="orange"
                                                                  IsChecked="{x:Bind views:Ui.IsColor(ColorId, 'orange'), Mode=OneWay}">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="■" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                            <ToggleMenuFlyoutItem Text="Sky blue" Command="{x:Bind SetColorCommand}" CommandParameter="skyBlue"
                                                                  IsChecked="{x:Bind views:Ui.IsColor(ColorId, 'skyBlue'), Mode=OneWay}">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="▲" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                            <ToggleMenuFlyoutItem Text="Mint" Command="{x:Bind SetColorCommand}" CommandParameter="mint"
                                                                  IsChecked="{x:Bind views:Ui.IsColor(ColorId, 'mint'), Mode=OneWay}">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="◆" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                            <ToggleMenuFlyoutItem Text="Pink" Command="{x:Bind SetColorCommand}" CommandParameter="pink"
                                                                  IsChecked="{x:Bind views:Ui.IsColor(ColorId, 'pink'), Mode=OneWay}">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="♥" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                            <ToggleMenuFlyoutItem Text="Navy" Command="{x:Bind SetColorCommand}" CommandParameter="navy"
                                                                  IsChecked="{x:Bind views:Ui.IsColor(ColorId, 'navy'), Mode=OneWay}">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="★" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                            <ToggleMenuFlyoutItem Text="Plum" Command="{x:Bind SetColorCommand}" CommandParameter="plum"
                                                                  IsChecked="{x:Bind views:Ui.IsColor(ColorId, 'plum'), Mode=OneWay}">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="⬢" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                            <ToggleMenuFlyoutItem Text="Forest" Command="{x:Bind SetColorCommand}" CommandParameter="forest"
                                                                  IsChecked="{x:Bind views:Ui.IsColor(ColorId, 'forest'), Mode=OneWay}">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="⬟" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                            <ToggleMenuFlyoutItem Text="Brick" Command="{x:Bind SetColorCommand}" CommandParameter="brick"
                                                                  IsChecked="{x:Bind views:Ui.IsColor(ColorId, 'brick'), Mode=OneWay}">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="♣" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                            <ToggleMenuFlyoutItem Text="Slate" Command="{x:Bind SetColorCommand}" CommandParameter="slate"
                                                                  IsChecked="{x:Bind views:Ui.IsColor(ColorId, 'slate'), Mode=OneWay}">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon FontFamily="Segoe UI Symbol" Glyph="✚" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Move earlier" Command="{x:Bind MoveEarlierCommand}" IsEnabled="{x:Bind CanMoveEarlier, Mode=OneWay}" />
                                        <MenuFlyoutItem Text="Move later" Command="{x:Bind MoveLaterCommand}" IsEnabled="{x:Bind CanMoveLater, Mode=OneWay}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Remove desktop…" Command="{x:Bind RequestRemoveCommand}" IsEnabled="{x:Bind CanRemove, Mode=OneWay}" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <!-- Top line: number badge on the left, pin and remove buttons on the right. -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid Width="{x:Bind BadgeSize, Mode=OneWay}" Height="{x:Bind BadgeSize, Mode=OneWay}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw">
                                        <Ellipse Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                 Visibility="{x:Bind views:Ui.CollapsedIf(IsCurrent), Mode=OneWay}" />
                                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                 Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2"
                                                 Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Index.ToString(), Mode=OneWay}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontSize="{x:Bind SmallFontSize, Mode=OneWay}"
                                                   Foreground="{x:Bind views:Ui.BadgeText(IsCurrent, ColorId), Mode=OneWay}" />
                                    </Grid>
                                    <!-- The colour's own symbol, so colour is never the only clue. -->
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                               FontFamily="Segoe UI Symbol"
                                               Text="{x:Bind ColorSymbol, Mode=OneWay}"
                                               FontSize="{x:Bind IconFontSize, Mode=OneWay}"
                                               Foreground="{x:Bind views:Ui.TileText(ColorId, x:False), Mode=OneWay}"
                                               Visibility="{x:Bind HasColor, Mode=OneWay}"
                                               AutomationProperties.AccessibilityView="Raw" />
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                            Command="{x:Bind TogglePinCommand}"
                                            AutomationProperties.Name="{x:Bind PinLabel, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind PinLabel, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind PinGlyph, Mode=OneWay}" FontSize="{x:Bind IconFontSize, Mode=OneWay}"
                                                  Foreground="{x:Bind views:Ui.PinBrush(IsPinned, IsOutOfOrder, ColorId), Mode=OneWay}" />
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                            Command="{x:Bind RequestRemoveCommand}"
                                            IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind RemoveLabel, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind RemoveLabel, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE711;" FontSize="{x:Bind IconFontSize, Mode=OneWay}"
                                                  Foreground="{x:Bind views:Ui.TileText(ColorId, x:False), Mode=OneWay}" />
                                    </Button>
                                </Grid>

                                <!-- The name, or (while renaming) a box to type a new one. -->
                                <TextBlock Grid.Row="1" VerticalAlignment="Center"
                                           Text="{x:Bind DisplayName, Mode=OneWay}"
                                           FontSize="{x:Bind NameFontSize, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind views:Ui.TileText(ColorId, x:False), Mode=OneWay}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind views:Ui.CollapsedIf(IsRenaming), Mode=OneWay}" />
                                <TextBox x:Name="NameBox" Grid.Row="1" VerticalAlignment="Center" MaxLength="60"
                                         Text="{x:Bind Name, Mode=OneWay}"
                                         PlaceholderText="{x:Bind DefaultName, Mode=OneWay}"
                                         FontSize="{x:Bind NameFontSize, Mode=OneWay}"
                                         Visibility="{x:Bind IsRenaming, Mode=OneWay}"
                                         AutomationProperties.Name="{x:Bind NameFieldLabel, Mode=OneWay}"
                                         AutomationProperties.HelpText="Type a name, up to 60 characters, and press Enter. Esc cancels."
                                         LostFocus="OnNameLostFocus"
                                         KeyDown="OnNameKeyDown" />

                                <!-- "Desktop 3 · current" -->
                                <TextBlock Grid.Row="2"
                                           Text="{x:Bind Subtitle, Mode=OneWay}"
                                           FontSize="{x:Bind SmallFontSize, Mode=OneWay}"
                                           Foreground="{x:Bind views:Ui.TileText(ColorId, x:True), Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- After clicking remove: a two-step confirmation covering the tile. -->
                                <StackPanel Grid.RowSpan="3" Spacing="6" Margin="-6"
                                            Padding="6" VerticalAlignment="Stretch"
                                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                            Visibility="{x:Bind IsConfirmingRemove, Mode=OneWay}">
                                    <Button x:Name="ConfirmRemoveButton" Content="Remove"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ConfirmRemoveCommand}"
                                            AutomationProperties.Name="{x:Bind ConfirmRemoveLabel, Mode=OneWay}"
                                            ToolTipService.ToolTip="Close this desktop. Its windows move to a neighbouring desktop." />
                                    <Button Content="Cancel"
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind CancelRemoveCommand}"
                                            AutomationProperties.Name="{x:Bind CancelRemoveLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- ===== SETTINGS (collapsed until you open it; Expander tells screen
                     readers whether it's open). Two columns when the grid is wide,
                     one column otherwise — arranged in PanelWindow.xaml.cs. ===== -->
                <Expander Header="Settings"
                          IsExpanded="{x:Bind ViewModel.IsSettingsExpanded, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          AutomationProperties.HeadingLevel="Level2">
                    <Grid x:Name="SettingsGrid" ColumnSpacing="32" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                        <!-- Each row: label on the left, control on the right. The control carries
                             the same label for screen readers, so nothing is read twice. -->
                        <StackPanel x:Name="SettingsColumnA" Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Desktop tile size" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <ComboBox Grid.Column="1" MinWidth="150"
                                          SelectedIndex="{x:Bind ViewModel.PanelTextSizeIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="Desktop tile size">
                                    <ComboBoxItem Content="Standard" />
                                    <ComboBoxItem Content="Large" />
                                    <ComboBoxItem Content="Extra large" />
                                    <ComboBoxItem Content="Largest" />
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Open with double-tap Ctrl (or Ctrl+Alt+S)" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                                <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                              IsOn="{x:Bind ViewModel.OpenWithHotKey, Mode=TwoWay}"
                                              AutomationProperties.Name="Open SpaceKeeper by double-tapping Control, or with Control Alt S"
                                              ToolTipService.ToolTip="Tap Ctrl twice quickly from any app. Ctrl+Alt+S also works." />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Show name when switching" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                              IsOn="{x:Bind ViewModel.ShowSwitchBanner, Mode=TwoWay}"
                                              AutomationProperties.Name="Show name when switching" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Notify when pinned order changes" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                              IsOn="{x:Bind ViewModel.NotifyPinMoves, Mode=TwoWay}"
                                              AutomationProperties.Name="Notify when pinned order changes" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Launch at sign-in" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                              IsOn="{x:Bind ViewModel.LaunchAtSignIn, Mode=TwoWay}"
                                              AutomationProperties.Name="Launch SpaceKeeper at sign-in" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="SettingsColumnB" Grid.Column="1" Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Show desktop name label" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                              IsOn="{x:Bind ViewModel.ShowDesktopLabel, Mode=TwoWay}"
                                              AutomationProperties.Name="Show desktop name label" />
                            </Grid>
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowDesktopLabel, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Label corner" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    <ComboBox Grid.Column="1" MinWidth="150"
                                              SelectedIndex="{x:Bind ViewModel.LabelCornerIndex, Mode=TwoWay}"
                                              AutomationProperties.Name="Label corner">
                                        <ComboBoxItem Content="Top left" />
                                        <ComboBoxItem Content="Top right" />
                                        <ComboBoxItem Content="Bottom left" />
                                        <ComboBoxItem Content="Bottom right" />
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Label opacity" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    <Slider Grid.Column="1" Width="150" Minimum="30" Maximum="100" StepFrequency="5"
                                            Value="{x:Bind ViewModel.LabelOpacityPercent, Mode=TwoWay}"
                                            AutomationProperties.Name="Label opacity, percent" />
                                </Grid>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Label and banner size" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <ComboBox Grid.Column="1" MinWidth="150"
                                          SelectedIndex="{x:Bind ViewModel.TextSizeIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="Label and banner text size">
                                    <ComboBoxItem Content="Standard" />
                                    <ComboBoxItem Content="Large" />
                                    <ComboBoxItem Content="Extra large" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Expander>

                <!-- ===== STATUS (LiveSetting makes screen readers announce changes) ===== -->
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />

                <!-- ===== DIAGNOSTICS ===== -->
                <Expander Header="Diagnostics" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Expanding="OnDiagnosticsExpanding">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="DiagnosticsText" FontFamily="Consolas" FontSize="12"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <Button Content="Copy report" Click="OnCopyDiagnostics" />
                    </StackPanel>
                </Expander>

                <!-- ===== FOOTER: shortcut reminder, tile size buttons, Quit ===== -->
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Double-tap Ctrl opens SpaceKeeper · Esc closes it"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <!-- Small "A" / big "A": the usual symbols for smaller / bigger text. -->
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                            Command="{x:Bind ViewModel.MakeSmallerCommand}"
                            IsEnabled="{x:Bind ViewModel.CanMakeSmaller, Mode=OneWay}"
                            AutomationProperties.Name="Smaller tiles"
                            ToolTipService.ToolTip="Smaller tiles (Ctrl+Minus)">
                        <TextBlock Text="A" FontSize="12" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                            Command="{x:Bind ViewModel.MakeBiggerCommand}"
                            IsEnabled="{x:Bind ViewModel.CanMakeBigger, Mode=OneWay}"
                            AutomationProperties.Name="Bigger tiles"
                            ToolTipService.ToolTip="Bigger tiles (Ctrl+Plus) · Ctrl+0 resets">
                        <TextBlock Text="A" FontSize="20" />
                    </Button>
                    <Button Grid.Column="3" Content="Quit" Click="OnQuit" Margin="8,0,0,0"
                            AutomationProperties.Name="Quit SpaceKeeper" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
